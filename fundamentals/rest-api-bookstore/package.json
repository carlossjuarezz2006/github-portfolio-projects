{
  "name": "rest-api-bookstore",
  "version": "1.0.0",
  "description": "A comprehensive REST API for a bookstore with authentication, CRUD operations, and full documentation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "docs": "swagger-jsdoc -d swaggerDef.js -o docs/swagger.json src/routes/*.js && swagger-ui-express-cli -f docs/swagger.json",
    "seed": "node src/utils/seedDatabase.js",
    "migrate": "node src/utils/migrations.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.11.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "dotenv": "^16.3.1",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^1.41.0",
    "nodemailer": "^6.9.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^9.1.1",
    "eslint": "^8.52.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "testTimeout": 10000
  },
  "eslintConfig": {
    "extends": ["airbnb-base"],
    "env": {
      "node": true,
      "jest": true
    },
    "rules": {
      "no-console": "off",
      "consistent-return": "off"
    }
  },
  "keywords": [
    "rest-api",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "authentication",
    "authorization",
    "swagger",
    "bookstore",
    "crud",
    "testing"
  ],
  "author": "Carlos Alberto Jurez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlos-alberto-jurez/rest-api-bookstore.git"
  },
  "bugs": {
    "url": "https://github.com/carlos-alberto-jurez/rest-api-bookstore/issues"
  },
  "homepage": "https://github.com/carlos-alberto-jurez/rest-api-bookstore#readme"
}
