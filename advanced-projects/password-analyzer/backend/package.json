{
  "name": "password-analyzer-backend",
  "version": "1.0.0",
  "description": "Advanced password strength analyzer with entropy calculation, pattern detection, and security assessment",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "analyze": "node src/cli/analyze.js",
    "update-datasets": "node src/utils/updateDatasets.js",
    "benchmark": "node src/benchmarks/performanceTest.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "zxcvbn": "^4.4.2",
    "crypto": "^1.0.1",
    "bcryptjs": "^2.4.3",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "chalk": "^4.1.2",
    "progress": "^2.0.3",
    "commander": "^11.0.0",
    "dotenv": "^16.3.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.52.0",
    "eslint-config-standard": "^17.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/cli/*.js"
    ]
  },
  "keywords": [
    "password",
    "security",
    "cryptography",
    "entropy",
    "strength",
    "analyzer",
    "cybersecurity",
    "authentication",
    "hashing",
    "brute-force"
  ],
  "author": "Carlos Alberto Jurez",
  "license": "MIT"
}
